[Unit]
Description=Walkie-Talkie Hub
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/walkie-talkie
EnvironmentFile=/etc/walkie-talkie/hub.env
ExecStart=/usr/bin/npm start --workspace=@walkie-talkie/hub
ExecStartPost=/bin/sh -c 'for i in $(seq 1 30); do curl -fsS http://127.0.0.1:${PORT:-9559}/health >/dev/null && exit 0; sleep 1; done; exit 1'
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
